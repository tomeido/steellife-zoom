# Google AI Studio Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
WHISPERX_BIN=whisperx
WHISPERX_MODEL=base

# Required when users join from different networks (mobile data, office VPN, etc.).
# Use a TURN server you operate and short-lived credentials in production.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_USERNAME=replace-with-turn-username
TURN_CREDENTIAL=replace-with-turn-credential
